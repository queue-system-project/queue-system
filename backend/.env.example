DATABASE_URL=postgresql+asyncpg://queue_user:replace-me@127.0.0.1:5432/queue_system
# Wygeneruj losowy sekret (co najmniej 32 znaki); nie zapisuj go w Git.
JWT_SECRET=
# Limit połączeń na proces. Uwzględnij łącznie pule API i procesu push.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
# Przed uruchomieniem zastosuj migracje 001–010. WebSocket wymaga jednego procesu API.
QUEUE_TIMERS_ENABLED=0
# Oferty wymagają włączonych timerów do wygaszania i obsługi kolejnych propozycji.
QUEUE_OFFERS_ENABLED=0
# Opcjonalne, tylko dla osobno uruchamianego procesu push:
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-service-account.json

# Email: ustaw prywatne dane nadawcy; bez nich rejestracja i odzyskiwanie zwracają 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
